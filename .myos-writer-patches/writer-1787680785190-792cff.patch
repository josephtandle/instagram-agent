+def human_pause(short: bool | str = False) -> None:
+    """Sleep like a person looking at a phone, not a script."""
+    import random
+    import time
+
+    is_short = short if isinstance(short, bool) else (str(short).lower() in ("glance", "short", "true"))
+    if is_short:
+        time.sleep(random.uniform(1.5, 4.0))
+        return
+    d = random.uniform(18, 55)
+    if random.random() < 0.12:  # occasionally they put the phone down
+        d += random.uniform(45, 150)
+    time.sleep(d)
 
 
