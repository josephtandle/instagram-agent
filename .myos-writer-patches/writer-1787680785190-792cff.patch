+def check_backoff(exc: Exception, username: str | None = None, source: str = "safety_brake") -> None:
+    """Hard safety brake: if exc is a rate-limit/challenge exception, apply protective cooldown, print message, and exit."""
+    from instagrapi.exceptions import (
+        ChallengeRequired,
+        FeedbackRequired,
+        PleaseWaitFewMinutes,
+        RateLimitError,
+    )
+
+    if isinstance(exc, (FeedbackRequired, RateLimitError, PleaseWaitFewMinutes, ChallengeRequired)):
+        uname = username or IG_USERNAME
+        apply_protective_cooldown(uname, source, exc)
+        msg = f"Safety brake triggered ({exc.__class__.__name__}): {exc}. Cooldown applied."
+        print(f"Error: {msg}", file=sys.stderr)
+        write_status("idle", "error", msg)
+        sys.exit(1)
+
+
